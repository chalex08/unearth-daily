# Copy this file to .env and fill in YOUR OWN values. .env is gitignored.
#
# Every devvit command loads .env (via dotenv). Precedence, highest first:
#   real environment variables  >  .env  >  devvit.json
# devvit.json stays the canonical config (app "unearth-daily" + the demo
# subreddit). These two variables give each developer an isolated lane.
# See CONTRIBUTING.md.

# Your personal dev app. Never set this to "unearth-daily".
DEVVIT_APP_NAME=unearth-dev-khushi

# Your personal playtest subreddit: fewer than 200 members, and you must moderate it.
# Note: this wins over a subreddit passed on the command line (devvit playtest r/foo).
DEVVIT_SUBREDDIT=unearth_dev_khushi

