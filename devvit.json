{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "unearth-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "permissions": {
    "reddit": {
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    },
    "redis": true,
    "journeys": true,
    "http": {
      "domains": ["generativelanguage.googleapis.com"]
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create today's Unearth post",
        "description": "Makes today's daily post if the 00:00 UTC job hasn't, or opens it.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Seed fake answer counts (dev)",
        "description": "Loads made-up counts for today's puzzle. Refuses on the canonical app.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/seed-fake-counts"
      },
      {
        "label": "Reset my run (dev)",
        "description": "Deletes your own run for today so you can play again. Refuses on the canonical app.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-my-run"
      },
      {
        "label": "Jump to a layer (dev)",
        "description": "Sets your run for today to any layer or the end screen. Refuses on the canonical app.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dev-jump"
      }
    ]
  },
  "forms": {
    "devJump": "/internal/form/dev-jump"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "dev": {
    "subreddit": "UnearthDaily"
  },
  "settings": {
    "global": {
      "geminiApiKey": {
        "type": "string",
        "label": "Gemini API key",
        "helpText": "Paid-tier key from the billed Google project only (never a free-tier key). Set with: npx devvit settings set geminiApiKey",
        "isSecret": true
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  }
}
