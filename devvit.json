{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "unearth-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "permissions": {
    "redis": true,
    "http": {
      "domains": ["generativelanguage.googleapis.com"]
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "unearth-daily",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/example-form"
      },
      {
        "label": "Seed fake answer counts (dev)",
        "description": "Loads made-up counts for today's puzzle. Refuses on the canonical app.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/seed-fake-counts"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "dev": {
    "subreddit": "UnearthDaily"
  },
  "settings": {
    "global": {
      "geminiApiKey": {
        "type": "string",
        "label": "Gemini API key",
        "helpText": "Paid-tier key from the billed Google project only (never a free-tier key). Set with: npx devvit settings set geminiApiKey",
        "isSecret": true
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  }
}
